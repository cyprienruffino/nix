# System configuration shared by all machines. Anything machine-specific
# lives in /etc/nixos/hardware-configuration.nix, imported below.

{ config, pkgs, pkgsKernel, lib, ... }:

{
  imports =
    [ # Machine-specific hardware config, generated by the installer. It is
      # deliberately imported from /etc (not tracked in this repo) so the same
      # repo works on any machine — the price is that system rebuilds need
      # --impure. See "Fresh install setup" in the README.
      /etc/nixos/hardware-configuration.nix
      ./work.nix
    ];

  # Bootloader.
  boot.loader.systemd-boot.enable = true;
  boot.loader.systemd-boot.configurationLimit = 10;
  boot.loader.efi.canTouchEfiVariables = true;

  # Latest kernel: 6.18 LTS lacks the SoundWire fallback machine driver this
  # laptop's Cirrus codecs need (no mic/speakers, HDMI-only "Pro Audio").
  # nixpkgs' evdi (1.14.15, pulled in by the displaylink driver below) does not
  # build against 7.2, so bump it to 1.15.1, which adds 7.2 support. 1.15.x
  # dropped the /etc/os-release lookup the nixpkgs prePatch rewrites. Its
  # kzalloc_obj conftest probe misfires under our build, so evdi redefines the
  # kernel's 7.2 macro and breaks acpi.h; only fall back when the kernel has
  # none. Drop the override once nixpkgs ships an evdi that builds on 7.2.
  # pkgsKernel pins linux 7.2.7 (see the nixpkgs-kernel input in flake.nix).
  boot.kernelPackages = pkgsKernel.linuxPackages_latest.extend (final: prev: {
    evdi = prev.evdi.overrideAttrs (old: {
      version = "1.15.1";
      src = pkgsKernel.fetchFromGitHub {
        owner = "DisplayLink";
        repo = "evdi";
        tag = "v1.15.1";
        hash = "sha256-3g6OETXJSf6AScJ2K9F67mPlh3Wpi20Yq+f+xe78p9Y=";
      };
      prePatch = ''
        substituteInPlace module/evdi_debug.h \
          --replace-fail '#ifndef EVDI_HAVE_KZALLOC_OBJ' \
                         '#if !defined(EVDI_HAVE_KZALLOC_OBJ) && !defined(kzalloc_obj)'
      '';
    });
  });

  # The hostname selects the flake output: `--flake .` resolves to
  # nixosConfigurations.<hostname>, so `nixos` machines get the personal
  # profile and `nixos-work` machines (set in work.nix) the work one.
  networking.hostName = lib.mkDefault "nixos";

  # nixos-rebuild switch updates /etc/hostname but NOT the kernel hostname —
  # that normally happens only at boot. Without this, switching a machine to
  # the other profile leaves `hostname` stale, and the next bare nrs/hms
  # quietly selects the OLD profile again (this actually happened). Setting it
  # during activation makes profile switches take effect immediately.
  system.activationScripts.setHostname = ''
    ${pkgs.nettools}/bin/hostname ${lib.escapeShellArg config.networking.hostName}
  '';
  networking.nameservers = [ "9.9.9.9" "149.112.112.112" ]; # Quad9

  # Enable networking
  networking.networkmanager.enable = true;

  # Automatically detect and set the time zone based on network location
  # (geoclue). Do not set time.timeZone here — it conflicts with, and would
  # relock, the timezone managed by automatic-timezoned.
  services.automatic-timezoned.enable = true;
  services.geoclue2.enable = true;

  # Select internationalisation properties.
  i18n.defaultLocale = "fr_FR.UTF-8";

  i18n.extraLocaleSettings = {
    LC_ADDRESS = "fr_FR.UTF-8";
    LC_IDENTIFICATION = "fr_FR.UTF-8";
    LC_MEASUREMENT = "fr_FR.UTF-8";
    LC_MONETARY = "fr_FR.UTF-8";
    LC_NAME = "fr_FR.UTF-8";
    LC_NUMERIC = "fr_FR.UTF-8";
    LC_PAPER = "fr_FR.UTF-8";
    LC_TELEPHONE = "fr_FR.UTF-8";
    LC_TIME = "fr_FR.UTF-8";
  };

  # Enable the X11 windowing system.
  # You can disable this if you're only using the Wayland session.
  services.xserver.enable = true;

  # Enable the KDE Plasma Desktop Environment.
  services.displayManager.sddm.enable = true;
  services.desktopManager.plasma6.enable = true;

  # Give Qt a platform plugin session-wide. Without this, kde-open (the
  # xdg-open backend on Plasma) aborts on startup, which breaks handling of
  # URL schemes like slack:// — e.g. Slack's "sign in via browser" redirect.
  environment.sessionVariables = {
    QT_QPA_PLATFORM = "wayland;xcb";
  };

  # DisplayLink docks/adapters. "displaylink" pulls in the evdi kernel module
  # and the DisplayLinkManager service; "modesetting" stays for the GPU.
  # The driver zip is non-redistributable (EULA), so it must be put in the
  # store manually once per machine before building:
  #   nix-prefetch-url --name displaylink-620.zip \
  #     'https://www.synaptics.com/sites/default/files/exe_files/2025-09/DisplayLink%20USB%20Graphics%20Software%20for%20Ubuntu6.2-EXE.zip'
  services.xserver.videoDrivers = [ "displaylink" "modesetting" ];

  # Configure keymap in X11
  services.xserver.xkb = {
    layout = "fr";
    variant = "";
  };

  # Configure console keymap
  console.keyMap = "fr";

  # Enable CUPS to print documents.
  services.printing.enable = true;

  # Enable bluetooth.
  hardware.bluetooth.enable = true;
  hardware.bluetooth.powerOnBoot = true;
  services.blueman.enable = true;

  # Enable sound with pipewire.
  services.pulseaudio.enable = false;
  security.rtkit.enable = true;
  services.pipewire = {
    enable = true;
    alsa.enable = true;
    pulse.enable = true;
    jack.enable = true;

    extraConfig.pipewire."92-low-latency" = {
      context.properties = {
        default.clock.rate = 48000;
        default.clock.quantum = 128;
        default.clock.min-quantum = 64;
        default.clock.max-quantum = 512;
      };
    };
  };

  programs.gamescope.enable = true;
  programs.gamemode.enable = true;

  # Define a user account. Don't forget to set a password with ‘passwd’.
  users.users."cyprien" = {
    isNormalUser = true;
    description = "Cyprien Ruffino";
    shell = pkgs.zsh;
    extraGroups = [ "networkmanager" "wheel" "adbusers" ];
  };

  # Steam needs system-level setup for OpenGL/Vulkan drivers and FHS environment.
  programs.steam.enable = true;
  hardware.graphics.enable32Bit = true;

  # Enable zsh system-wide (required to set it as default shell)
  programs.zsh.enable = true;

  # Compatibility layer for pip-installed native binaries (no /lib on NixOS)
  programs.nix-ld.enable = true;
  programs.nix-ld.libraries = with pkgs; [
    stdenv.cc.cc  # libstdc++.so.6
    zlib          # libz.so.1
    glib          # libglib-2.0.so.0
    libGL         # libGL.so.1  (opencv)
    ffmpeg_7.lib  # libavcodec.so.61 and friends (ffmpeg 7.1)
    (lib.getLib cudaPackages_13.libnpp)  # libnppicc.so.13 etc. (torchcodec)
  ];

  # Enable flakes and new nix CLI
  nix.settings.experimental-features = [ "nix-command" "flakes" ];

  # Allow unfree packages
  nixpkgs.config.allowUnfree = true;

  # Network debugging toolkit. Everything else is user-level (home-manager).
  environment.systemPackages = with pkgs; [
    dnsutils    # dig, nslookup, host
    nettools    # netstat, ifconfig, route, arp
    nmap        # port scanning
    traceroute
    whois
    mtr         # combined traceroute + ping
    tcpdump     # packet capture
    iperf3      # bandwidth testing
    lsof        # list open files/sockets
  ];

  swapDevices = [{
    device = "/var/lib/swapfile";
    size = 8 * 1024;
  }];

  # nh handles generation cleanup + GC for both system and user profiles
  # (runs as root, unlike a home-manager nh timer). Replaces nix.gc, which
  # cannot be enabled alongside it. `flake` sets NH_FLAKE for the nh CLI.
  programs.nh = {
    enable = true;
    flake = "/home/cyprien/nix";
    clean.enable = true;
    clean.extraArgs = "--keep-since 4d --keep 3";
  };

  # This value determines the NixOS release from which the default
  # settings for stateful data, like file locations and database versions
  # on your system were taken. It‘s perfectly fine and recommended to leave
  # this value at the release version of the first install of this system.
  # Before changing this value read the documentation for this option
  # (e.g. man configuration.nix or on https://nixos.org/nixos/options.html).
  system.stateVersion = "26.05"; # Did you read the comment?
}
